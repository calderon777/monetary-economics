   "source": [
    "---\n",
    "title: \"Topic 2: Song Generation - Ludic Activity\"\n",
    "subtitle: \"AI-Assisted Music Creation with ACE-Step 1.5\"\n",
    "author: \"EC3014 - Monetary Economics\"\n",
    "date: today\n",
    "format: html\n",
    "---\n",
    "\n",
    "## 🎵 Create Your Own Song\n",
    "\n",
    "Welcome to the **Song Generation Lab**! In this ludic activity, you'll:\n",
    "\n",
    "1. **Write lyrics or narrative** based on economic concepts from Topic 2\n",
    "2. **Provide a music prompt** (genre, mood, style)\n",
    "3. **ACE-Step 1.5 generates the music locally** to accompany your words\n",
    "4. **Reflect** on the creative process and economic ideas\n",
    "\n",
    "> **Note:** This activity uses **ACE-Step 1.5**, a free, open-source music generation model running locally. No API keys needed!\n",
    "\n",
    "---\n",
    "\n",
    "## Your Creative Input"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "f03b2d60",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "============================================================\n",
      "SONG GENERATION FORM - DEMONSTRATION\n",
      "============================================================\n",
      "\n",
      "============================================================\n",
      "SUBMISSION RECEIVED\n",
      "============================================================\n",
      "Student: Economics Student\n",
      "Lyrics (first 80 chars): Inflation's rising, money's value falls,\n",
      "Central banks step in to answer the cal...\n",
      "Music Style: analytical yet upbeat, economics-themed, educational\n",
      "\n",
      "Generating music starting in 3 seconds...\n",
      "\n"
     ]
    }
   ],
   "source": [
    "#| echo: false\n",
    "\n",
    "import os\n",
    "from pathlib import Path\n",
    "import requests\n",
    "import json\n",
    "from datetime import datetime\n",
    "import time\n",
    "\n",
    "# Configuration\n",
    "ACESTEP_API_URL = \"http://localhost:8001\"\n",
    "OUTPUT_DIR = Path(\"generated_songs\")\n",
    "OUTPUT_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "# Sample data for demonstration (replace with actual student input)\n",
    "# In an interactive environment, you would use input() instead\n",
    "print(\"=\" * 60)\n",
    "print(\"SONG GENERATION FORM - DEMONSTRATION\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Example student inputs (modify these in your own notebook)\n",
    "student_name = \"Economics Student\"\n",
    "student_lyrics = \"\"\"Inflation's rising, money's value falls,\n",
    "Central banks step in to answer the calls.\n",
    "Interest rates climbing, purchasing power tight,\n",
    "Monetary policy's steering the ship right.\n",
    "Classical theory meets the modern age,\n",
    "As economic forces take center stage.\"\"\"\n",
    "\n",
    "music_prompt = \"analytical yet upbeat, economics-themed, educational\"\n",
    "\n",
    "# Store metadata\n",
    "metadata = {\n",
    "    \"student\": student_name,\n",
    "    \"timestamp\": datetime.now().isoformat(),\n",
    "    \"lyrics\": student_lyrics,\n",
    "    \"music_prompt\": music_prompt\n",
    "}\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"SUBMISSION RECEIVED\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"Student: {student_name}\")\n",
    "print(f\"Lyrics (first 80 chars): {student_lyrics[:80]}...\")\n",
    "print(f\"Music Style: {music_prompt}\")\n",
    "print(\"\\nGenerating music starting in 3 seconds...\\n\")\n",
    "\n",
    "time.sleep(1)  # Brief pause for display"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cbe6502c",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "## 🤖 AI Music Generation with ACE-Step 1.5"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "99b76016",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "🎵 Connecting to ACE-Step 1.5 API...\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "⚠️  ACE-Step API not running!\n",
      "\n",
      "🚀 To start the API, open a new terminal and run:\n",
      "   uv run acestep-api\n",
      "\n",
      "The API will start on http://localhost:8001\n"
     ]
    }
   ],
   "source": [
    "#| echo: false\n",
    "\n",
    "def generate_music_with_acestep(lyrics: str, music_prompt: str) -> dict:\n",
    "    \"\"\"\n",
    "    Call ACE-Step 1.5 local API to generate music with lyric conditioning\n",
    "    \n",
    "    Args:\n",
    "        lyrics: Student-written lyrics or narrative\n",
    "        music_prompt: Description of music style/genre\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with audio data and metadata\n",
    "    \"\"\"\n",
    "    \n",
    "    payload = {\n",
    "        \"lyrics\": lyrics,\n",
    "        \"prompt\": music_prompt,\n",
    "        \"duration\": 30,  # 30 seconds for quick generation\n",
    "        \"temperature\": 0.7\n",
    "    }\n",
    "    \n",
    "    headers = {\"Content-Type\": \"application/json\"}\n",
    "    \n",
    "    try:\n",
    "        print(\"🎵 Sending request to ACE-Step API...\")\n",
    "        response = requests.post(\n",
    "            f\"{ACESTEP_API_URL}/generate\",\n",
    "            json=payload,\n",
    "            headers=headers,\n",
    "            timeout=300  # 5 min timeout for generation\n",
    "        )\n",
    "        \n",
    "        if response.status_code == 200:\n",
    "            return {\n",
    "                \"success\": True,\n",
    "                \"audio_bytes\": response.content,\n",
    "                \"lyrics\": lyrics,\n",
    "                \"prompt\": music_prompt\n",
    "            }\n",
    "        else:\n",
    "            return {\n",
    "                \"success\": False,\n",
    "                \"error\": f\"API returned status {response.status_code}\",\n",
    "                \"message\": response.text,\n",
    "                \"hint\": \"Is ACE-Step API running? Check: uv run acestep-api\"\n",
    "            }\n",
    "    \n",
    "    except requests.exceptions.ConnectionError:\n",
    "        return {\n",
    "            \"success\": False,\n",
    "            \"error\": \"Cannot connect to ACE-Step API on localhost:8001\",\n",
    "            \"hint\": \"Start ACE-Step API with: uv run acestep-api\"\n",
    "        }\n",
    "    except Exception as e:\n",
    "        return {\n",
    "            \"success\": False,\n",
    "            \"error\": str(e),\n",
    "            \"hint\": \"Check ACE-Step installation and API startup\"\n",
    "        }\n",
    "\n",
    "# Generate music\n",
    "print(\"🎵 Connecting to ACE-Step 1.5 API...\")\n",
    "\n",
    "# Check if API is reachable\n",
    "try:\n",
    "    response = requests.get(f\"{ACESTEP_API_URL}/health\", timeout=5)\n",
    "    api_ready = response.status_code == 200\n",
    "except:\n",
    "    api_ready = False\n",
    "\n",
    "if api_ready:\n",
    "    result = generate_music_with_acestep(student_lyrics, music_prompt)\n",
    "    \n",
    "    if result[\"success\"]:\n",
    "        # Save audio file\n",
    "        filename = f\"{OUTPUT_DIR}/song_{datetime.now().strftime('%Y%m%d_%H%M%S')}.wav\"\n",
    "        with open(filename, \"wb\") as f:\n",
    "            f.write(result[\"audio_bytes\"])\n",
    "        \n",
    "        # Save metadata\n",
    "        metadata_file = filename.replace(\".wav\", \"_metadata.json\")\n",
    "        metadata[\"output_file\"] = filename\n",
    "        with open(metadata_file, \"w\") as f:\n",
    "            json.dump(metadata, f, indent=2)\n",
    "        \n",
    "        print(f\"✅ Music generated successfully!\")\n",
    "        print(f\"📁 Saved to: {filename}\\n\")\n",
    "        song_file = filename\n",
    "        \n",
    "    else:\n",
    "        print(f\"❌ Error generating music: {result.get('error', 'Unknown error')}\")\n",
    "        print(f\"💡 Hint: {result.get('hint', '')}\")\n",
    "        song_file = None\n",
    "else:\n",
    "    print(\"⚠️  ACE-Step API not running!\")\n",
    "    print(\"\\n🚀 To start the API, open a new terminal and run:\")\n",
    "    print(\"   uv run acestep-api\")\n",
    "    print(\"\\nThe API will start on http://localhost:8001\")\n",
    "    song_file = None"
   ]
  },
  {
   "cell_type": "markdown",
