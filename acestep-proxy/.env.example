# ACE-Step proxy configuration (copy to .env and edit)

# Where the real ACE-Step API is running (usually on the same server or private network)
ACESTEP_TARGET_BASE=http://127.0.0.1:8001

# Browser origins allowed to call this proxy (comma-separated)
PROXY_ALLOWED_ORIGINS=https://calderon777.github.io,http://localhost,http://127.0.0.1

# Optional shared token (only enable if your frontend can send X-Proxy-Token)
PROXY_SHARED_TOKEN=
PROXY_REQUIRE_TOKEN=false

# Proxy behavior
PROXY_REQUEST_TIMEOUT_SECONDS=600

# Basic in-memory rate limiting (per IP)
PROXY_RATE_LIMIT_WINDOW_SECONDS=60
PROXY_RATE_LIMIT_MAX_REQUESTS=30

# Topic 2 pilot scoring / community settings
TOPIC2_MAX_LYRICS_WORDS=120
TOPIC2_MAX_LYRICS_CHARS=800
TOPIC2_MAX_PROMPT_WORDS=20
TOPIC2_MAX_PROMPT_CHARS=140
TOPIC2_MAX_SCORING_SUBMISSIONS_PER_NICK=5

# Google Sheets persistence (via Google Apps Script web app URL, same pattern as topicNmcqs.qmd)
TOPIC2_ENABLE_GOOGLE_SHEETS=false
TOPIC2_GOOGLE_SHEETS_WORKBOOK=
TOPIC2_GOOGLE_SHEETS_ENDPOINT=
TOPIC2_GOOGLE_SHEETS_TAB=topic2ludic
